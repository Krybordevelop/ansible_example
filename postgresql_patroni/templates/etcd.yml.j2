ETCD_NAME="{{ inventory_hostname }}"
ETCD_DATA_DIR="/var/lib/etcd/default"
ETCD_LISTEN_CLIENT_URLS="http://0.0.0.0:{{ etcd_client_port }}"
ETCD_ADVERTISE_CLIENT_URLS="http://{{ node_ip }}:{{ etcd_client_port }}"
ETCD_LISTEN_PEER_URLS="http://0.0.0.0:{{ etcd_peer_port }}"
ETCD_INITIAL_ADVERTISE_PEER_URLS="http://{{ node_ip }}:{{ etcd_peer_port }}"
ETCD_INITIAL_CLUSTER="{% for host in groups['postgres_cluster'] %}{{ host }}=http://{{ hostvars[host].node_ip }}:{{ etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}"
ETCD_INITIAL_CLUSTER_STATE="new"
ETCD_INITIAL_CLUSTER_TOKEN="{{ postgres_cluster_name }}-etcd"
