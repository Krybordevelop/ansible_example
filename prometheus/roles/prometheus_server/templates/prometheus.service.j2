[Unit]
Description=Prometheus monitoring server
Wants=network-online.target
After=network-online.target

[Service]
User={{ prometheus_user }}
Group={{ prometheus_group }}
Type=simple
ExecStart={{ prometheus_binary_path }} \
  --config.file={{ prometheus_config_path }} \
  --storage.tsdb.path={{ prometheus_data_dir }} \
  --web.listen-address={{ prometheus_listen_address }} \
  --web.console.templates={{ prometheus_install_dir }}/consoles \
  --web.console.libraries={{ prometheus_install_dir }}/console_libraries
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target